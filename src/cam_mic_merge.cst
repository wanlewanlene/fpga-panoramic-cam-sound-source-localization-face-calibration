// ---- 状态指示灯：扩展到扩展板 H3 排针（18P, 2.54mm），便于用 LED / 万用表直接观察 ----
//  H3 丝印（第 n 脚 = 网络名）：1=R16  2=W21  3=P15  4=U20  5=T20  6=Y21  7=N15  8=AB21
//                              9=R14 10=Y18 11=P14 12=AA20 13=U18 14=AA18 15=U17 16=AA19 18=W17
//  注意：H3 无 GND/电源脚，参考地请用 U1.26 / U2.15 或 H1.1。
//  本 5 脚分属 BANK7/BANK8，电平假设与原先一致（3.3V）。
//  ⚠ 原选用的 V17 / V20 在本板上分别是 cam2 的 D0 与麦克风 MIC_D2，已被占用，故移开。
//  典型接法：H3 对应脚 -- 470R -- LED -- GND
IO_LOC "state_led[0]" W17;
IO_PORT "state_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "state_led[1]" Y18;
