IO_LOC  "diag_uart_tx" G11;
IO_PORT "diag_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//====== UART 输出（U15 -> 板载 USB 桥片；PULL_UP 保证空闲高电平）======
//  [合并工程] 这一脚现在是「视频诊断 + 麦克风 DOA 文本」合流后的输出，
//  由 uart_merge 做字节级互斥，不由任何单一子系统直连。
IO_LOC  "uart_pc_tx" U15;
IO_PORT "uart_pc_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//=============================================================================
//  音频子系统引脚  ——  7 麦阵列 I2S 飞线 + SK9822 灯环 + 状态灯
//  （来源：audio_i2s/eda_proj/src/audio.cst，2026-10-14 飞线方案）
//
//  [合并工程] 与视频侧零冲突：8 根飞线全部落在原 SDRAM BANK 的 3.3V 引脚，
//  视频侧（三路 DVP + DDR3 + HDMI）不使用该 BANK 的任何脚。
//
//  但四个状态灯必须改绑：原 audio.cst 用的 C18/E19/D20/F15 在本板上分别是
//  cam1 的 VS / HREF / RST_N / D1，合并后已被三路摄像头占用。改到扩展板
//  H3 排针的 P14/P15/U17/N15（该组原本就是 audio.cst 里注释掉的备用方案）。
//
//  !! 飞线三点注意（沿用原工程结论）!!
//   1. 这 8 根是 SDRAM 数据线，本项目不用 SDRAM 才能这么绑。
//   2. 电平双向匹配：阵列侧 3.3V 逻辑，DRIVE 已降到 4mA 抑制振铃。
//   3. 线要短、成对走 GND 伴线；阵列板需单独 5V 供电。
//=============================================================================

//------ 麦克风阵列 I2S（FPGA 作主机：CK/WS 为输出）------
IO_LOC  "mic_array_bck"     A13;        // 原 sdram_dq[7]   MIC_CK 3.125MHz
IO_PORT "mic_array_bck"     IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "mic_array_ws"      A14;        // 原 sdram_dq[6]   MIC_WS 48.83kHz
IO_PORT "mic_array_ws"      IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

//------ 4 路麦克风数据（每根线上两个麦分时复用，由 WS 相位选择）------
IO_LOC  "mic_array_d[3]"    C13;        // 原 sdram_dq[5]   MIC_D3
IO_PORT "mic_array_d[3]"    IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "mic_array_d[2]"    B16;        // 原 sdram_dq[15]  MIC_D2
IO_PORT "mic_array_d[2]"    IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "mic_array_d[1]"    B15;        // 原 sdram_dq[14]  MIC_D1
IO_PORT "mic_array_d[1]"    IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "mic_array_d[0]"    B13;        // 原 sdram_dq[4]   MIC_D0
IO_PORT "mic_array_d[0]"    IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//------ 阵列板上的 SK9822 灯环（12 颗，2 线总线）------
IO_LOC  "mic_led_clk"       C14;        // 原 sdram_dq[3]   LED_CK 2.5MHz
IO_PORT "mic_led_clk"       IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "mic_led_dat"       C15;        // 原 sdram_dq[2]   LED_DA
IO_PORT "mic_led_dat"       IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

//------ 麦克风状态灯（H3 排针：11=P14, 3=P15, 15=U17, 7=N15）------
IO_LOC  "mic_leds[0]"       P14;
IO_PORT "mic_leds[0]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mic_leds[1]"       P15;
IO_PORT "mic_leds[1]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mic_leds[2]"       U17;
IO_PORT "mic_leds[2]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mic_leds[3]"       N15;
IO_PORT "mic_leds[3]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
